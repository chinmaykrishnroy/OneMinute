# Local development only. scripts/dev.ps1 init generates fresh local secrets.
APP_ENV=development
WEB_PORT=3000
API_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379
POSTGRES_DB=encounter
POSTGRES_USER=encounter
POSTGRES_PASSWORD=replace-with-a-random-password
REDIS_PASSWORD=replace-with-a-random-password
WEB_ORIGIN=http://localhost:3000
# TURN uses direct networking, never an ordinary Cloudflare Tunnel.
# For two browsers on this machine use 127.0.0.1; for LAN use this host's LAN IP.
TURN_PUBLIC_IP=127.0.0.1
TURN_PORT=3478
TURN_RELAY_MIN=49160
TURN_RELAY_MAX=49180
TURN_REALM=local.encounter
TURN_SECRET=replace-with-at-least-32-random-bytes
TURN_ALLOW_PRIVATE_PEERS=true
# Networking lab is explicitly opt-in and forbidden in production.
RTC_LAB_ENABLED=false
API_PUBLIC_URL=http://localhost:8080
GOOGLE_CLIENT_ID=
